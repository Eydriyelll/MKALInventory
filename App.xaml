<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MkalInventoryApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryOrange">#FF6F00</Color>
            <Color x:Key="LightOrange">#FFF3E0</Color>
            <Color x:Key="SurfaceWhite">#FFFFFF</Color>
            <Color x:Key="BackgroundGray">#F2F3F5</Color>
            <Color x:Key="InputFill">#F3F4F6</Color>
            <Color x:Key="InkDark">#1F2933</Color>
            <Color x:Key="DarkText">#1F2933</Color>
            <Color x:Key="MutedText">#6B7280</Color>
            <Color x:Key="LineGray">#E3E5E8</Color>
            <Color x:Key="DangerRed">#C62828</Color>
            <Color x:Key="OkGreen">#2E7D32</Color>

            <!-- Buttons: primary by default; secondary / danger / tab / ghost / small variants -->
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryOrange}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="16,0" />
            </Style>
            <Style TargetType="Button" Class="secondary">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource DarkText}" />
                <Setter Property="BorderColor" Value="{StaticResource LineGray}" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>
            <Style TargetType="Button" Class="danger">
                <Setter Property="BackgroundColor" Value="{StaticResource DangerRed}" />
            </Style>
            <Style TargetType="Button" Class="tab">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource DarkText}" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
            <Style TargetType="Button" Class="ghost">
                <Setter Property="BackgroundColor" Value="#34404B" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HeightRequest" Value="38" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="Button" Class="small">
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <!-- Inputs -->
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource DarkText}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource MutedText}" />
                <Setter Property="BackgroundColor" Value="{StaticResource InputFill}" />
                <Setter Property="HeightRequest" Value="44" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource DarkText}" />
                <Setter Property="TitleColor" Value="{StaticResource MutedText}" />
                <Setter Property="BackgroundColor" Value="{StaticResource InputFill}" />
                <!-- MinimumHeightRequest, not HeightRequest: on Windows the Title sits above the box inside the control,
                     so a fixed height squeezed the box and hid the chosen option. -->
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="{StaticResource DarkText}" />
                <Setter Property="BackgroundColor" Value="{StaticResource InputFill}" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{StaticResource DarkText}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource MutedText}" />
                <Setter Property="BackgroundColor" Value="{StaticResource InputFill}" />
            </Style>

            <!-- Text -->
            <Style TargetType="Label" Class="title">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource DarkText}" />
            </Style>
            <Style TargetType="Label" Class="section">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource DarkText}" />
            </Style>
            <Style TargetType="Label" Class="muted">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource MutedText}" />
            </Style>
            <Style TargetType="Label" Class="th">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource DarkText}" />
            </Style>
            <Style TargetType="Label" Class="cell">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource DarkText}" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Cards and table rows -->
            <Style TargetType="Border" Class="card">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource LineGray}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>
            <Style TargetType="Border" Class="row">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource LineGray}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="StrokeShape" Value="RoundRectangle 6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
